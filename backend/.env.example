# Optional AI provider keys (backend-only — never put these in frontend or VITE_* vars)
# Gemini takes precedence when GEMINI_API_KEY is configured.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash
# Gemini requests automatically retry temporary 429/5xx responses before failing.
# AI_PROVIDER=gemini # Optional: gemini, groq, openai, or openrouter

# OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here

# Model routing (use models available to your OpenAI project)
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Optional: OpenRouter fallback if Gemini and OpenAI are not set (backend-only)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional Groq fallback when Gemini is temporarily unavailable.
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Optional paid search providers (backend-only). If unset, free web search is used.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# Optional SQLite path (default: backend/comet.db)
# COMET_DATABASE_PATH=./comet.db

# Comma-separated frontend origins for deployed environments.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
