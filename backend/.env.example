# Required: OpenAI (backend-only — never put this in frontend or VITE_* vars)
OPENAI_API_KEY=your_openai_api_key_here

# Model routing (use models available to your OpenAI project)
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Optional: OpenRouter fallback if OpenAI is not set (backend-only)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional paid search providers (backend-only). If unset, free web search is used.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# Optional SQLite path (default: backend/comet.db)
# COMET_DATABASE_PATH=./comet.db

# Comma-separated frontend origins for deployed environments.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
